{
  "name": "my-library",
  "version": "1.0.0",
  "description": "TypeScript library with build, lint, format, and release setup",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsup": "^7.2.0",
    "eslint": "^9.4.0",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "commitlint": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^20.12.12",
    "tsx": "^4.7.1",
    "@eslint/js": "^9.4.0",
    "typescript-eslint": "^7.8.0",
    "eslint-config-prettier": "^9.1.0"
  },
  "keywords": [],
  "author": "Serhiy",
  "license": "MIT"
}
